# Source this file on lvzihao after adjusting input locations. It contains no
# credentials and is intentionally safe to copy outside the Git checkout.
export HOST_PROJECT_ROOT=/home/twiddle/Developer/Latent-Cosmos-Synth-rave-midi-integration
export HOST_REPO_ROOT="$HOST_PROJECT_ROOT/repo"
export HOST_FLOW_ROOT="$HOST_PROJECT_ROOT/runtime/serum128"

export LV_IMAGE=midibrave:lvzihao-cu128-v1
export LV_CONTAINER_WORK_ROOT=/data/midibrave-zrave-flow-serum128
export LV_PACK_RELATIVE=packs/serum-balanced

# The existing Serum128 config refers to these read-only container locations.
# Point the host values at the synchronized inputs; never put tokens here.
export LV_RAVE_ROOT="$HOST_PROJECT_ROOT/runtime/rave-serum-v2"
export LV_SOURCE_ROOT="$HOST_PROJECT_ROOT/runtime/source/serum-octopus-v1"

# qgpu's measured usable ceiling on this host is 32G. The submitter rejects
# requests above 32G and always asks for one GPU.
export LV_CPUS=8
export LV_MEMORY=32G
export LV_DOCKER_CPUS=8
export LV_DOCKER_MEMORY=30g
export LV_TIME_LIMIT=72:00:00
export LV_ALLOCATIONS=8

# Optional controlled overrides:
# export LV_BATCH_PER_GPU=16
# export LV_PITCH_BATCH_PER_GPU=64
# export LV_INITIALIZE_FROM="$HOST_FLOW_ROOT/runs/pure-flow-v1/checkpoints/step-085000.pt"
# export LV_PITCH_PROBE="$HOST_FLOW_ROOT/runs/pitch-probe"

# MIDI audition decoded-audio CREPE qualification uses a separate immutable
# offline image. The official torchcrepe 0.0.24 tiny asset is bundled in the
# image and must match this SHA before any report is accepted.
export LV_AUDIO_EVAL_IMAGE=midibrave:lvzihao-cu128-audio-eval-v1
export LV_CREPE_MODEL_SHA256=d4993eea36ed1a0ad9ac549c740dae5265b049ce72004f00c2f59e01c0be8432

# Optional, independent frozen-CLAP audio/audio report queue. This is not used
# by category/proxy training queues. It requires a separately audited
# CLAP-capable image and the exact Octopus authority asset synchronized below
# HOST_FLOW_ROOT; do not substitute an uncalibrated timbre model.
# export LV_IMAGE=midibrave:lvzihao-cu128-clap-v1
# export LV_CLAP_CHECKPOINT="$HOST_FLOW_ROOT/model-weights/laion-clap/music_audioset_epoch_15_esc_90.14.pt"
# export LV_CLAP_EXPECTED_SHA256=fae3e9c087f2909c28a09dc31c8dfcdacbc42ba44c70e972b58c1bd1caf6dedd
