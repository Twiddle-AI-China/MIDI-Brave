# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- Model weights & checkpoints ---
# Keep these on Spark/Octopus, never in git. v1 on Octopus is 4.9 GB of these.
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.npz
checkpoints/
artifacts/

# --- Training / eval outputs ---
runs/
outputs/
reports/
tensorboard/
events.out.tfevents.*
wandb/
slurm-*.out
*.sbatch.log

# --- Rendered audio ---
# Audition packs are regenerated by the eval pipeline; do not commit WAVs.
*.wav
*.flac
*.mp3
*.ogg
*.aif
*.aiff

# --- Secrets & local env ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets.yaml

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# --- Explicitly kept (evidence cited by the v5 handoff doc) ---
!docs/assets/**
!docs/evidence/**
