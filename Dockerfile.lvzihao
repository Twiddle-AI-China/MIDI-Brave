ARG BASE_IMAGE=pytorch/pytorch:2.9.1-cuda12.8-cudnn9-runtime@sha256:7b324d212a4450795b49edba9949b7cdc72429148a64e974334bfe5774d51385
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.title="MidiBrave lvzihao trainer" \
      org.opencontainers.image.description="Single-GPU Blackwell runtime for MidiBrave Z-RAVE experiments"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTORCH_KERNEL_CACHE_PATH=/tmp/torch-kernels

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates ffmpeg git libsndfile1 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/MidiBrave

# Keep the CUDA-enabled torch stack supplied by the base image. These are the
# userspace packages needed by the Z-RAVE path and the existing MIDI/CLAP code.
RUN python -m pip install \
      numpy==1.26.4 \
      soundfile==0.12.1 \
      scipy==1.17.0 \
      PyYAML==6.0.2 \
      tensorboard==2.21.0 \
      pytest==8.3.5 \
      librosa==0.11.0 \
      resampy==0.4.3 \
      torchlibrosa==0.1.0 \
      ftfy==6.3.1 \
      braceexpand==0.1.7 \
      webdataset==1.0.2 \
      wget==3.2 \
      progressbar==2.5 && \
    python -m pip install --no-deps \
      torchcrepe==0.0.24 \
      laion-clap==1.1.7

COPY pyproject.toml README.md ./
COPY src ./src
COPY configs ./configs
COPY scripts ./scripts
COPY tests ./tests
COPY training_profiles ./training_profiles

RUN python -m pip install --no-deps . && \
    python - <<'PY'
import sys
import torch

assert sys.version_info[:2] == (3, 11), sys.version
assert torch.__version__.startswith("2.9.1"), torch.__version__
assert torch.version.cuda == "12.8", torch.version.cuda
PY

CMD ["/bin/bash"]
