ARG BASE_IMAGE=pytorch/pytorch:2.9.1-cuda12.8-cudnn9-runtime@sha256:7b324d212a4450795b49edba9949b7cdc72429148a64e974334bfe5774d51385
FROM ${BASE_IMAGE}
ARG EXPECTED_TORCH_PREFIX=2.9.1

LABEL org.opencontainers.image.title="MidiBrave lvzihao trainer" \
      org.opencontainers.image.description="Single-GPU Blackwell runtime for MidiBrave Z-RAVE experiments"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_HTTP_TIMEOUT=300 \
    PYTORCH_KERNEL_CACHE_PATH=/tmp/torch-kernels \
    EXPECTED_TORCH_PREFIX=${EXPECTED_TORCH_PREFIX} \
    PATH=/app/.venv/bin:${PATH} \
    PYTHONPATH=/workspace/MidiBrave/src

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates ffmpeg git libsndfile1 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/MidiBrave

# Keep the CUDA-enabled torch stack supplied by the base image. Install only
# the userspace packages imported by the Z-RAVE flow/pitch/audition path.
RUN if python -m pip --version >/dev/null 2>&1; then \
      install_command="python -m pip install"; \
    else \
      command -v uv >/dev/null; \
      install_command="uv pip install --python $(command -v python)"; \
    fi && \
    $install_command \
        numpy==1.26.4 \
        soundfile==0.12.1 \
        scipy==1.17.0 \
        PyYAML==6.0.2 \
        tensorboard==2.20.0

COPY pyproject.toml README.md ./
COPY src ./src
COPY configs ./configs
COPY scripts ./scripts
COPY tests ./tests
COPY training_profiles ./training_profiles

RUN python - <<'PY'
import os
import sys
import torch
import yaml
import numpy
import scipy
import soundfile
import tensorboard

from midibrave import zrave_flow_audition
from midibrave import zrave_flow_train
from midibrave import zrave_pitch_train

assert sys.version_info[:2] == (3, 11), sys.version
assert torch.__version__.startswith(os.environ["EXPECTED_TORCH_PREFIX"]), (
    torch.__version__,
    os.environ["EXPECTED_TORCH_PREFIX"],
)
assert torch.version.cuda == "12.8", torch.version.cuda
assert zrave_flow_audition is not None
assert zrave_flow_train is not None
assert zrave_pitch_train is not None
PY

ENTRYPOINT []
CMD ["/bin/bash"]
